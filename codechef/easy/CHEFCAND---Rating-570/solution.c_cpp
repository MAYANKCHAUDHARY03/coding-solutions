#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int n, x;
    cin>>n>> x;
    if(n>x){
        if((n - x) < 4){
            cout<< (n-x)<< endl;
        }
        else{
            if((n - x)% 4 == 0){
    cout<<(n - x) / 4<<endl;}
            else{
                cout<<(n - x) % 4<<endl;
            }
        }}
    else{
        cout<<"0"<<endl;
    }
}
}
