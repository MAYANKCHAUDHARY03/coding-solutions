#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n, x;
        cin >> n >> x;
        if (n <= x) {
            cout << "0\n";
        }
        else {
            int c = n - x;
            int d = (c + 3) / 4;
            cout << d << endl;
        }
    }
}