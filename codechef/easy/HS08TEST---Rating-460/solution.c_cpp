#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int x;
    cin >> x;
    float y;
    cin >> y;
    if (x > y) {
        cout << y;
    }
    else {
        if (x % 5 == 0) {
            cout << y - x - 0.5;
        }
        else {
            cout << y;
        }
    }
}