#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>> t;
while(t--){
    int x, m, d;
    cin >> x >> m >> d;
    if((x + d) >= (x * m)){
        cout<< (x * m)<<endl;
    }
    else if((x + d) < (x * m)){
        cout<< (x + d)<<endl;
    }
    else{
        cout<< ((x + d) - (x * m))<<endl;
    }
}
}
