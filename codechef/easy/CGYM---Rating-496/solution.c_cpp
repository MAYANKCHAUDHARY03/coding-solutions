#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int x, y, z;
        cin >> x >> y >> z;
        if (z < x) {
            cout << "0\n";
        }
        else if (z > x && z < x + y) {
            cout << "1\n";
        }
        else {
            cout << "2\n";
        }
    }
}