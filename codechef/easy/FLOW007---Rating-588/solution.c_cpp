#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n, t = 0;
        cin >> n;
        while (n > 0) {
            t += n % 10;
            n /= 10;
            t *= 10;
        }
        cout << t/10 << endl;
    }
}