#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        if (n < 16) {
            if (n < 11) {
                cout << "LOWER DOUBLE\n";
            }
            else {
                cout << "LOWER SINGLE\n";
            }
        }
        else {
            if (n < 26) {
                cout << "UPPER DOUBLE\n";
            }
            else {
                cout << "UPPER SINGLE\n";
            }
        }
    }
}