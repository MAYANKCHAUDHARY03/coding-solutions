#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int x, y;
        cin >> x >> y;
        if (10 * x == y) {
            cout << "CLOTH\n";
        }
        else if (10 * x > y) {
            cout << "CLOTH\n";
        }
        else {
            cout << "DISPOSABLE\n";
        }
    }
}