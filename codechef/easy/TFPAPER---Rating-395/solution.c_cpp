#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int x;
        cin >> x;
        if (x < 4) {
            cout << "BRONZE\n";
        }
        else if (x > 6) {
            cout << "GOLD\n";
        }
        else {
            cout << "SILVER\n";
        }
    }
}