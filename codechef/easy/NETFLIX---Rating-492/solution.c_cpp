#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int c, x, y;
        cin >> c >> x >> y;
        if (x >= c) {
            cout << "0\n";
        }
        else {
            cout << (c - x) * y << endl;
        }
    }
}