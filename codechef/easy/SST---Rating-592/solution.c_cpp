#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int a, b;
        cin >> a >> b;
        if ((a * 2) == b) {
            cout << "ANY\n";
        }
        else if ((a * 2) > b) {
            cout << "FIRST\n";
        }
        else if ((a * 2) < b) {
            cout << "SECOND\n";
        }
    }
}