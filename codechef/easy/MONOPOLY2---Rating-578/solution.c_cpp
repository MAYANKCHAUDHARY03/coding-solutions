#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>> t;
while(t--){
    int p, q, r, s;
    cin>> p>> q>> r>> s;
    if((p > (q+r+s)) || (r > (q+p+s)) || (q >= (p+r+s)) || (s >= (q+r+p))){
        cout<<"YES\n";
    }
    else{
        cout<<"NO\n";
    }
}
}
