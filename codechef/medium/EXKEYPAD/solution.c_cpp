#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;

    while (t--) {
        long long n;
        int a;
        cin >> n >> a;
        while (1) {
            long long x = n;
            int b = 0;
            while (x > 0) {
                if (x % 10 == a) {
                    b = 1;
                    break;
                }
                x /= 10;
            }
            if (b == 0)
                break;
            n++;
        }
        cout << n << endl;
    }
}