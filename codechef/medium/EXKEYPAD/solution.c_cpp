#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        long long n;
        int d;
        cin >> n >> d;

        while (1) {
            long long x = n;
            int found = 0;

            while (x > 0) {
                if (x % 10 == d) {
                    found = 1;
                    break;
                }
                x /= 10;
            }

            if (found == 0) break;
            n++;
        }

        cout << n << endl;
    }
}