#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        long long n, m, r, c;
        cin >> n >> m >> r >> c;
        long long d = min({
            max(r-1, c-1),
            max(r-1, m-c),
            max(n-r, c-1),
            max(n-r, m-c)
        });
        cout << d + n + m - 2 + min(n-1, m-1) << endl;
    }
}