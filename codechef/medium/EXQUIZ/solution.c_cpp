#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;

    while (t--) {
        int n, s, ans = -1;
        cin >> n >> s;

        for (int c = 0; c <= n; c++) {
            int w = 4 * c - s;

            if (w >= 0 && c + w <= n) {
                ans = c + w;
                break;
            }
        }

        cout << ans << endl;
    }
}