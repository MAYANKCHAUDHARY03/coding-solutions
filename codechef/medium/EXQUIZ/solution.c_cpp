#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n, s;
        cin >> n >> s;

        if (s < 0 || s > 4 * n)
            cout << -1 << endl;
        else if (s % 4 == 0)
            cout << s / 4 << endl;
        else
            cout << s / 4 + 1 << endl;
    }
}