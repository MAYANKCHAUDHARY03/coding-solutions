#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;

    while (t--) {
        int n, s, ans = -1;
        cin >> n >> s;

        for (int c = 0; c <= n; c++) {
            int a = 4 * c - s;

            if (a >= 0 && c + a <= n) {
                ans = c + a;
                break;
            }
        }

        cout << ans << endl;
    }
}