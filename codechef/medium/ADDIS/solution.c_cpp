#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int a[n];
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        sort(a, a + n);
        int b = 1, c = 1;
        for (int i = 1; i < n; i++) {
            if (a[i] == a[i - 1]) {
                c++;
            }
            else {
                c = 1;
            }
            b = max(b, c);

        }
        cout << (b + 1) / 2 << endl;
    }
}