#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>> t;
while(t--){
    int n, odd=0, even=0;
    cin>> n;
    int a[100];
    for(int i=0; i<n; i++){
        int x;
        cin>> x;
        if(x%2){
            odd++;
        }
        else{
            even++
        }
    }
    cout<< min(n, 2*(min(odd, even))+1)<<endl;
}
}
