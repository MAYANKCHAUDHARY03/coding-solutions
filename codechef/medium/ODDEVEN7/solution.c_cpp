#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n, x = 0, y = 0;
        cin >> n;
        int a[100];
        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            if (x % 2) {
                x++;
            }
            else {
                y++;
            }
        }
        cout << min(n, 2 * (min(x, y)) + 1) << endl;
    }
}