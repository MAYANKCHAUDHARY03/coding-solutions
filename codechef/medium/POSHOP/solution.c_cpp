#include <bits/stdc++.h>

using namespace std;
int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int a[100];
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        int x = 0;
        for (int i = 0; i < n; i++) {
            x = max(x, a[i]);
            for (int j = i + 1; j < n; j++) {
                if (a[i] <= a[j]) {
                    x = max(x, a[i] + a[j]);
                }
            }
        }
        cout<< x<<endl;
    }
}