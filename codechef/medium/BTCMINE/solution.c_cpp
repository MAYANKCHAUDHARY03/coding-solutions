#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>>t;
while(t--){
    int x, y;
    cin>> x>> y;
    int a=0, b=0, c=0;
    while(b<=0){
        c++;
        if(a==0 || x< (y*(2*a+1)){
            a++;
        }
        b+=(y*a*a-(a>0 && c<=a ? x:0));
    }
    cout<<c<<endl;
}
}
