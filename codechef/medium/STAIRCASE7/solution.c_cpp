#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int a[400005] = {}, big = 0;
        for (int i = 1; i <= n; i++) {
            int x;
            cin >> x;
            a[x - i + n]++;
            big = max(big, a[x - i + n]);
        }
        cout << n - big << endl;
    }
}