#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int a, b, p, q, r;
        cin >> a >> b >> p >> q >> r;
        int k = 100;
        for (int i = 0; i <= min(a, b); i++) {
            int x = a - i;
            int y = b - i;
            int z = i * r;
            z += ((x + 1) / 2) * p;
            z += ((y + 1) / 2) * q;
            k = min(k, z);
        }
        cout << k << endl;
    }
}