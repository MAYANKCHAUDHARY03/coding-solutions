#include <bits/stdc++.h>
using namespace std;
int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, m;
        cin >> n >> m;
        int ans = 0, H = 0, V = 0, S = 0;
        for (int h = 0; h <= n; h++) {
            for (int v = 0; v <= n/2; v++) {
                int s = min(n-h-2*v, m-2*h-v);

                if (s >= 0 && 2*h+2*v+s > ans) {
                    ans = 2*h+2*v+s;
                    H = h;
                    V = v;
                    S = s;
                }
            }
        }
        vector<string> a(n, string(m, '.'));
        int r = 0, c = 0;
        for (int i = 0; i < H; i++) {
            a[r][c] = a[r][c+1] = 'R';
            r++;
            c += 2;
        }
        for (int i = 0; i < V; i++) {
            a[r][c] = a[r+1][c] = 'R';
            r += 2;
            c++;
        }
        for (int i = 0; i < S; i++) {
            a[r][c] = 'R';
            r++;
            c++;
        }
        cout << ans << "\n";
        for (int i = 0; i < n; i++)
            cout << a[i] << "\n";
    }
}