#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
cin>> t;
while(t--){
    int n;
    cin>>n;
    int a[1000000], b[1000000];
    for(int i=1;i<=n;i++){
        cin>> a[i];
        b[a[i]]=i;
    }
    int k=0;
    int x[1000000], y[1000000];
    for(int i=1; i<=n; i++){
        if(a[i] !=i){
            int j =b[i];
            k++;
            x[k]=i;
            y[k]=j;
            int c=a[i];
            a[i]=a[j];
            a[j]=c;
            b[a[j]]=j;
            b[a[i]]=i;
        }
    }
    cout<<k<<endl;
    for(int i=1; i<=k; i++){
        cout<< x[i]<<" "<<y[i]<<endl;
    }
}
}
