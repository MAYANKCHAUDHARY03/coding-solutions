#include <bits/stdc++.h>
using namespace std;
int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int a[1000000], b[1000000];
        for (int i = 0; i < n; i++) {
            cin >> a[i];
            b[a[i]] = i;
        }
        int k = 0;
        int x[1000000], y[1000000];
        for (int i = 1; i <= n; i++) {
            cin>> a[i];
            b[a[i]]=i;
        }
        while(true){
            int p=-1;
            int q=0;
            for(i=0; i<n;i++){
                if(a[i]!= i){
                    int r=a[i]-i;
                    if(r<0){
                        r= -r;
                    }
                    if(r>q){
                        q=r;
                        p=i;
                    }
                }
            }
            if(p==-1){
                break;
            }
            int l=b[p];
            x[k]=p;
            y[k]=l;
            k++;
            int c=a[p];
            a[p]=a[l];
            a[l]=c;
            b[a[p]]=p;
            b[a[l]]=l;
        }
        
        cout << k << endl;
        for (int i = 0; i < k; i++) {
            cout << x[i] << " " << y[i] << endl;
        }
    }
}