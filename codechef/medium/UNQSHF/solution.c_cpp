#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        string a, b;
        cin >> a >> b;
        int c = 0;
        int d = 0;
        for (char e: a) {
            if (e == 'a') {
                c++;
            }
        }
        for (char e: b) {
            if (e == 'b') {
                d++;
            }
        }
        if (c == d) {
            cout << "YES\n";
        }
        else {
            cout << "NO\n";
        }

    }
}