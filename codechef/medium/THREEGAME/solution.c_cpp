#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        long long n;
        cin >> n;
        if (n % 3 == 0) {
            cout << n + 1 << endl;
        }
        else if (n % 3 == 1) {
            cout << n << endl;
        }
        else {
            cout << n + 2 << endl;
        }
    }
}