#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        long long n;
        cin >> n;
        long long result;
        if (n % 2 == 0) {
           result= 3 * (n / 2) + 1;
        }
        else {
            result = (3 * (n - 1)) / 2;
        }
        cout << result << endl;
    }
}