#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        long long a[5005], sum = 0, ans = 0;

        for (int i = 0; i < n; i++) {
            cin >> a[i];
            sum += a[i];
        }

        for (int i = 0; i < n; i++) {
            a[i] *= 2;

            long long s = 0, mx = 0;

            for (int j = 0; j < n; j++) {
                s += a[j];
                mx = max(mx, a[j]);
            }

            ans = max(ans, s - mx);
            a[i] /= 2;
        }

        cout << ans << endl;
    }

    return 0;
}