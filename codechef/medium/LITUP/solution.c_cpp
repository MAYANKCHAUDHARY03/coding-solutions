#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        int a[N];

        for (int i = 0; i < N; i++)
            cin >> a[i];

        int ans = 1000000000;

        for (int i = 0; i < N; i++) {
            for (int j = i + 1; j < N; j++) {
                if (i <= K && j >= N - K - 1 && j <= i + 2 * K + 1) {
                    if (a[i] + a[j] < ans)
                        ans = a[i] + a[j];
                }
            }
        }

        if (ans == 1000000000)
            cout << -1 << endl;
        else
            cout << ans << endl;
    }

}
