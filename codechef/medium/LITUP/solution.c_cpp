#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        vector<int> C(N);
        for (int i = 0; i < N; i++)
            cin >> C[i];

        int ans = 1e9;

        for (int i = 0; i < N; i++) {
            for (int j = i + 1; j < N; j++) {
                if (i <= K && j >= N - K - 1 && j - i <= 2 * K + 1)
                    ans = min(ans, C[i] + C[j]);
            }
        }

        if (ans == 1e9)
            cout << -1 << endl;
        else
            cout << ans << endl;
    }
}
