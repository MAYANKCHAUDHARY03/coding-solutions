#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;
        int a[n];
        for (int i = 0; i < n; i++)
            cin >> a[i];
        int ans = 1000000000;
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                if (i <= k && j >= n - k - 1 && j <= i + 2 * k + 1) {
                    if (a[i] + a[j] < ans)
                        ans = a[i] + a[j];
                }
            }
        }
        if (ans == 1000000000)
            cout << "-1" << endl;
        else
            cout << ans << endl;
    }
}