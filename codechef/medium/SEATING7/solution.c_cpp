#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
int t;
while(t--){
    int n,m,k;
    cin>>n>>m>>k;
    int a[n+1]={};
    for(int i=0;i<m;i++){
        int x;
        cin>>x;
        a[x]=1;
    }
    int x=1;
    while(k--){
        while(a[x]){
            x++;
        }
        cout<<x<<" ";
        a[x]=1;
    }
    cout<<endl;
}
}
