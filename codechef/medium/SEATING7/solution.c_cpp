#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    while (t--) {
        int n, m, k;
        cin >> n >> m >> k;
        bool a[105] = {};
        for (int i = 0; i < m; i++) {
            int x;
            cin >> x;
            a[x] = true;
        }
        int x = 1;
        for(int i=0;i<k;i++) {
            while (a[x]) 
                x++;
            
            cout << x << " ";
            a[x] = 1;
        }
        cout << endl;
    }
}