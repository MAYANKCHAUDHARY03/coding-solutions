#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        if (k > n) {
            if (2 * k >= n) {
                cout << "YES\n";
            }}
            else {
                cout << "NO\n";
            
        }
    }
}